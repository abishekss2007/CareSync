# Copy this file to .env and fill in what you use. Never commit .env.

# 1 shows the one-click demo accounts on the sign-in page. Set to 0 for real use.
DEMO_MODE=1

# IBM watsonx.ai: turns the "Summarise history" button into a watsonx.ai call.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct

# IBM Db2 on Cloud (optional). Leave empty to use the local SQLite file.
# Needs: pip install ibm_db ibm_db_sa
# DATABASE_URL=db2+ibm_db://USER:PASSWORD@HOST:PORT/bludb;SECURITY=SSL
DATABASE_URL=

# Embed link of the Cognos dashboard (can also be set in the app under Admin and audit).
COGNOS_DASHBOARD_URL=

# Cloud PostgreSQL that IBM Cognos reads live (for example a free Supabase project).
# The app keeps its own database and pushes de-identified reporting tables here every few seconds.
# Needs: pip install "psycopg[binary]"
# ANALYTICS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
ANALYTICS_DATABASE_URL=
